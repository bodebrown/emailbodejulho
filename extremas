     BLOCO 5 - AS CERVEJAS
     ============================================================ -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#000000" style="border-collapse:collapse;background-color:#000000;">
  <tr>
    <td bgcolor="#000000" align="center" style="background-color:#000000;padding:0;">
